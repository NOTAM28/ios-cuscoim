 /*
+ * GCC clocks for QUP0 SE4 (Xiaomi apollo-q-oss drivers/clk/qcom/gcc-kona.c).
+ * Boot 6 hung on the first SPI register write after stage 2 read only the
+ * SE's common registers: the SE4 clock is off under fastboot boot. All
+ * branches are voted in APCS_CLOCK_BRANCH_ENA_VOTE_1; BIT(31) of each halt
+ * register is CLK_OFF. The SE4 RCG runs in DFS mode when firmware set it.
+ */
+#define TOUCH_GCC_PA         0x00100000u
+#define TOUCH_GCC_SIZE       0x60000
+#define TOUCH_GCC_VOTE       0x52008u
+#define TOUCH_GCC_VOTE_MASK  ((0xfu << 6) | (1u << 14)) /* m/s AHB, core, core 2x, S4 */
+#define TOUCH_GCC_RCG        0x174d0u       /* gcc_qupv3_wrap0_s4_clk_src */
+
+/*
  * SM8250 TLMM tiles (west, south, north), each with registers only for the
  * pins it owns. Boot 4: gpio8/9 lived in north, other tiles read 0. Stage 1
  * reads the pins in all three and keeps the tile where they are non-zero.
