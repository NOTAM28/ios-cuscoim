+/* ---------- GCC: QUP0 SE4 clocks ---------- */
+/*
+ * Vote the wrapper and SE4 clocks on and pick a 19.2 MHz (XO, divider 1, no
+ * M/N) source: a DFS level for SE_GENI_CLK_SEL, or the RCG itself without
+ * DFS. Returns the CLK_SEL level, or -1 (logged) when nothing safe exists.
+ */
+static int
+touch_clocks(void)
+{
+	static const uint32_t branches[] = {0x17004, 0x17008, 0x23000, 0x23008, 0x174cc};
+	int level = -1;
+
+	touch_wr(st.gcc, TOUCH_GCC_VOTE, touch_rd(st.gcc, TOUCH_GCC_VOTE) | TOUCH_GCC_VOTE_MASK);
+	uint32_t dfs = touch_rd(st.gcc, TOUCH_GCC_RCG + 0x14u);
+	uint32_t cfg = touch_rd(st.gcc, TOUCH_GCC_RCG + 4u);
+	printf("SWEET TOUCH: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    touch_rd(st.gcc, TOUCH_GCC_VOTE), touch_rd(st.gcc, TOUCH_GCC_RCG), cfg, dfs);
+	if (dfs & 1u) {
+		for (unsigned l = 0; l < 8; ++l) {
+			uint32_t lv = touch_rd(st.gcc, TOUCH_GCC_RCG + 0x1cu + 4u * l);
+			printf("SWEET TOUCH: dfs level %u cfg=%#x\n", l, lv);
+			if (level < 0 && (lv & 0x371fu) == 1u)
+				level = (int)l;
+		}
+		if (level < 0) {
+			printf("SWEET TOUCH: no XO/1 DFS level; SE4 clock left alone\n");
+			return -1;
+		}
+	} else {
+		/* XO parent 0, HID divider 1 => 19.2 MHz. No PLL or voltage change. */
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		touch_wr(st.gcc, TOUCH_GCC_RCG + 4u, cfg);
+		touch_wr(st.gcc, TOUCH_GCC_RCG, touch_rd(st.gcc, TOUCH_GCC_RCG) | 1u);
+		if (!touch_wait_clear(st.gcc, TOUCH_GCC_RCG, 1u)) {
+			printf("SWEET TOUCH: RCG update timeout\n");
+			return -1;
+		}
+		level = 0;
+	}
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		if (!touch_wait_clear(st.gcc, branches[i], 1u << 31)) {
+			printf("SWEET TOUCH: GCC branch %#x still off (%#x)\n", branches[i],
+			    touch_rd(st.gcc, branches[i]));
+			return -1;
+		}
+	}
+	printf("SWEET TOUCH: SE4 clocks on, clk-sel %d\n", level);
+	return level;
+}
