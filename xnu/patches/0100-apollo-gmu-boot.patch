+/* ---- memory the GMU reaches through the SMMU (HackiOS's gpu_space) ---- */
+static void
+gpu_to_memory(vm_offset_t start, vm_size_t size)
+{
+	for (vm_offset_t line = start & ~(vm_offset_t)63; line < start + size; line += 64)
+		__asm__ volatile("dc civac, %0" : : "r"(line) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+#define GPU_SPACE_TABLES 64
+static struct {
+	unsigned count;
+	uint64_t *table[GPU_SPACE_TABLES];
+	uint64_t phys[GPU_SPACE_TABLES];
+} gmu_space;
+
+static uint64_t *
+gpu_new_table(void)
+{
+	static vm_offset_t spare;
+	static unsigned spare_left;
+	if (gmu_space.count == GPU_SPACE_TABLES)
+		return NULL;
+	if (spare_left == 0) {
+		if (kmem_alloc(kernel_map, &spare, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS)
+			return NULL;
+		spare_left = PAGE_SIZE / 4096;
+	}
+	uint64_t *t = (uint64_t *)(spare + PAGE_SIZE - 4096u * spare_left--);
+	gmu_space.phys[gmu_space.count] = kvtophys((vm_offset_t)t);
+	gmu_space.table[gmu_space.count++] = t;
+	return t;
+}
+
+static uint64_t *
+gpu_next_table(uint64_t *entry)
+{
+	if (*entry & 1) {
+		for (unsigned i = 0; i < gmu_space.count; ++i)
+			if (gmu_space.phys[i] == (*entry & PTE_ADDRESS))
+				return gmu_space.table[i];
+		return NULL;
+	}
+	uint64_t *t = gpu_new_table();
+	if (t)
+		*entry = kvtophys((vm_offset_t)t) | PTE_TABLE;
+	return t;
+}
+
+/* One 4K page; three levels, 39-bit addresses (DT qcom,use-3-lvl-tables). */
+static bool
+gpu_map(uint64_t va, uint64_t pa)
+{
+	if ((va >> 39) || (gmu_space.count == 0 && !gpu_new_table()))
+		return false;
+	uint64_t *l2 = gpu_next_table(&gmu_space.table[0][(va >> 30) & 0x1ff]);
+	uint64_t *l3 = l2 ? gpu_next_table(&l2[(va >> 21) & 0x1ff]) : NULL;
+	if (!l3)
+		return false;
+	l3[(va >> 12) & 0x1ff] = pa | PTE_GMU | PTE_PAGE;
+	return true;
+}
+
+struct gpu_block {
+	uint32_t va, size;
+	vm_offset_t mem;
+};
+
+static bool
+gpu_block_new(struct gpu_block *b, uint32_t va, uint32_t size)
+{
+	b->va = va;
+	b->size = (size + 4095u) & ~4095u;
+	if (kmem_alloc(kernel_map, &b->mem, round_page(b->size), KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS)
+		return false;
+	for (uint32_t o = 0; o < b->size; o += 4096u)
+		if (!gpu_map(va + o, kvtophys(b->mem + o)))
+			return false;
+	gpu_to_memory(b->mem, b->size);
+	printf("SWEET GPU:   GMU %#x..%#x -> our %#llx (%#x bytes)\n", va, va + b->size - 1,
+	    (unsigned long long)kvtophys(b->mem), b->size);
+	return true;
+}
